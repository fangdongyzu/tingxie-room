rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isOpenTest(testId) {
      return exists(/databases/$(database)/documents/tests/$(testId))
        && get(/databases/$(database)/documents/tests/$(testId)).data.status == 'open'
        && (
          !get(/databases/$(database)/documents/tests/$(testId)).data.keys().hasAny(['closesAt'])
          || get(/databases/$(database)/documents/tests/$(testId)).data.closesAt == null
          || request.time < get(/databases/$(database)/documents/tests/$(testId)).data.closesAt
        );
    }

    match /admins/{adminEmail} {
      allow read: if signedIn() && request.auth.token.email == adminEmail;
      allow create: if signedIn()
        && request.auth.token.email == adminEmail
        && adminEmail in [
          'tristanlpd@gm.lhu.edu.tw',
          'tristanlpd@gmail.com'
        ]
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt']);
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'
        ]);
      allow delete: if false;
    }

    match /tests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && isOpenTest(request.resource.data.testId)
        && submissionId == request.resource.data.testId + '_' + request.auth.uid
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.status == 'submitted'
        && request.resource.data.grade == null
        && request.resource.data.gradedAt == null
        && request.resource.data.gradedBy == null
        && request.resource.data.resubmitAllowed == false
        && request.resource.data.resubmitAllowedAt == null
        && request.resource.data.resubmitAllowedBy == null
        && request.resource.data.resubmissionCount == 0
        && request.resource.data.resubmittedAt == null
        && request.resource.data.keys().hasOnly([
          'testId', 'testCode', 'testTitle', 'className', 'userId',
          'studentName', 'studentEmail', 'studentPhotoURL', 'answer',
          'deviceCode', 'startedAt', 'submittedAt', 'status', 'grade',
          'correction', 'feedback', 'gradedAt', 'gradedBy', 'metrics',
          'resubmitAllowed', 'resubmitAllowedAt', 'resubmitAllowedBy',
          'resubmissionCount', 'resubmittedAt'
        ]);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.resubmitAllowed == true
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.testId == resource.data.testId
        && request.resource.data.testCode == resource.data.testCode
        && request.resource.data.testTitle == resource.data.testTitle
        && request.resource.data.className == resource.data.className
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.studentPhotoURL == resource.data.studentPhotoURL
        && request.resource.data.status == 'submitted'
        && request.resource.data.grade == null
        && request.resource.data.correction == ''
        && request.resource.data.feedback == ''
        && request.resource.data.gradedAt == null
        && request.resource.data.gradedBy == null
        && request.resource.data.resubmitAllowed == false
        && request.resource.data.resubmitAllowedAt == resource.data.resubmitAllowedAt
        && request.resource.data.resubmitAllowedBy == resource.data.resubmitAllowedBy
        && request.resource.data.resubmissionCount == resource.data.resubmissionCount + 1
        && request.resource.data.resubmittedAt == request.time
        && request.resource.data.submittedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentName', 'answer', 'deviceCode', 'startedAt', 'submittedAt',
          'status', 'grade', 'correction', 'feedback', 'gradedAt', 'gradedBy',
          'metrics', 'resubmitAllowed', 'resubmissionCount', 'resubmittedAt'
        ])
      );
      allow delete: if isAdmin();
    }
  }
}
